PORT=3000
DATABASE_URL=postgres://postgres:notes@localhost:5432/notes
# Generate with: openssl rand -base64 32
JWT_SECRET=
# BullMQ's jobs and the locks. A database number in the path keeps them apart: redis://localhost:6379/1
REDIS_URL=redis://localhost:6379
# The browser origins allowed to call the API, comma-separated. None by default.
CORS_ORIGINS=

# Mail: `log` writes each mail to the console. `smtp` sends it, and requires SMTP_URL.
MAIL_TRANSPORT=log
# SMTP_URL=smtp://user:password@smtp.example.com:587
MAIL_FROM="Notes <notes@example.com>"

# NestJS Observe: `npx @nestjs/observe link` writes these. Empty, the SDK sends nothing.
# OBSERVE_APP_KEY=
# OBSERVE_APP_SECRET=

# Read when the modules load, before .env is: set these in the process environment, not here.
#   DIGEST_CRON='*/10 * * * * *'   the digest's schedule (default: 18:00 UTC every day)
#   MAIL_WORKER=off                this process adds jobs but doesn't run them (see npm run start:worker)
